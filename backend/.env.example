# Local development uses SQLite. The PostgreSQL examples below are used by Neon on Vercel.
DATABASE_URL="file:./dev.db"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Generate a unique random secret with at least 32 characters; never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
